# Maintainer: bariscanatakli

pkgname=hyprpeaz-greeter
pkgver=1.0.0
pkgrel=4
pkgdesc="Greetd config for HyprPeaz greeter"
arch=('any')
license=('custom')
depends=(
    'greetd'
    'hyprpeaz'
)
makedepends=('git')
install="${pkgname}.install"
url="https://github.com/bariscanatakli/hypr-peaz"
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/bariscanatakli/hypr-peaz/archive/refs/heads/v2.tar.gz")
sha256sums=('SKIP')

package() {
    install -Dm644 "${srcdir}/hypr-peaz-2/greeter/config.toml" \
        "${pkgdir}/usr/share/${pkgname}/config.toml"
}
